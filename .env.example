# =========================================================================
# NEXT.JS CINEMATIC PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =========================================================================
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env.local" in the same directory.
# 2. Fill in the placeholder values with your actual service credentials.
# 3. NEVER commit your actual ".env.local" file to public Git repositories!
#
# =========================================================================

# -------------------------------------------------------------------------
# Firebase Client Configuration (Public variables used for Firestore connectivity)
# -------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# -------------------------------------------------------------------------
# Resend Mailing Service Configuration (Private secrets - KEEP SECURE!)
# -------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_TO_EMAIL=your_inbox_email_to_receive_messages@gmail.com
